APP_NAME="Barber SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Superadmin: único usuário inicial, criado por `php artisan db:seed`.
# Sem SUPERADMIN_PASSWORD o seeder gera uma senha aleatória e a exibe no console.
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=superadmin@barber.test
SUPERADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_TIMEZONE=America/Sao_Paulo
DB_DATABASE=barber_saas
DB_USERNAME=barber
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@barbersaas.local"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Cloud API (Meta) — bot de agendamento.
# `verify_token`: valor arbitrário combinado no app do Meta; o webhook responde
#   ao desafio só se bater. `app_secret`: assinatura X-Hub-Signature-256.
# `access_token`: token global de envio; a barbearia pode ter o próprio em
#   tenants.whatsapp_settings.access_token (comando whatsapp:channel).
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LOG_REQUEST_ID=true

# Asaas (gateway de pagamento) — integração futura de cobrança recorrente.
# Sem chave a aplicação opera só o fluxo manual de mensalidades.
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX=true
